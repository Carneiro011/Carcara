# PROJETO CARCARÁ — Variáveis de ambiente
# Copie para .env e preencha antes de rodar

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-chave-longa-e-aleatoria
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_NAME=carcara_db
DB_USER=carcara_user
DB_PASSWORD=carcara_pass
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Obter em: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── E-mail (recuperação de senha) ─────────────────────────────────────────────
# Em desenvolvimento, remova ou comente EMAIL_BACKEND para usar o console
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@carcara.br
# No Gmail: use "Senha de app" (não a senha normal da conta)
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=Carcará <noreply@carcara.br>

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL base do app — usada no link de redefinição de senha enviado por e-mail
FRONTEND_URL=https://app.carcara.nupreds.br

# Validade do link de reset em segundos (259200 = 3 dias)
PASSWORD_RESET_TIMEOUT=259200
