
# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requisições por hora para cada tipo de cliente
THROTTLE_ANON=20/hour    # não autenticado (login, registro, esqueci-senha)
THROTTLE_USER=200/hour   # autenticado (envio de observações, consultas)
THROTTLE_LOGIN=10/hour   # tentativas de login por IP (força bruta)
